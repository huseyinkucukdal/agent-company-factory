ACF_DATA_DIR=/app/data
ACF_LOG_LEVEL=INFO

# ----------------------------------------------------------------------
# LLM provider (Module 19)
# ----------------------------------------------------------------------
# Choose one of: mock | github_models | anthropic | openai
# Default is "mock" — agents end every turn immediately, no API calls.
LLM_PROVIDER=mock

# Model name. Defaults: gpt-4o-mini for github_models / openai;
# claude-3-5-sonnet-latest is recommended for anthropic.
# LLM_MODEL=gpt-4o-mini

# Generation knobs (optional)
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_TOKENS=2048
# LLM_TEMPERATURE=0.7

# --- GitHub Models (free tier via GitHub PAT) ---
# 1. Create a PAT with the "models:read" scope at
#    https://github.com/settings/tokens
# 2. pip install -e '.[llm-openai]'   (or rebuild the Docker image)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_GITHUB_MODELS_BASE_URL=https://models.github.ai/inference

# --- Anthropic (Claude) ---
# 1. Get an API key at https://console.anthropic.com
# 2. pip install -e '.[llm-anthropic]'   (or rebuild the Docker image)
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_ANTHROPIC_BASE_URL=

# --- OpenAI ---
# 1. Get an API key at https://platform.openai.com/api-keys
# 2. pip install -e '.[llm-openai]'   (or rebuild the Docker image)
# 3. Set LLM_PROVIDER=openai (and optionally LLM_MODEL=gpt-4o-mini)
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_OPENAI_BASE_URL=https://api.openai.com/v1
